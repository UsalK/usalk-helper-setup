# Copy is unnecessary: first startup creates backend/.env when it is missing.
# Configure your own credentials in the setup wizard or backend/.env.
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REDIRECT_URI=
OPENROUTER_API_KEY=

# Optional Shopify connection; no store is connected by default.
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SHOP_NAME=
SHOPIFY_THEME_PATH=

# Optional order image upscaling (Siparişler > Upscale). Leave the engine's
# settings empty to disable the button. Outputs: storage/etsy/<Shop>/upscaled/
# UPSCALE_ENGINE=realesrgan   # realesrgan (default) | command
# UPSCALE_SCALE=6
# realesrgan: path to the local Real-ESRGAN based upscale.py
UPSCALE_SCRIPT=
# UPSCALE_PYTHON=python
# command: any CLI upscaler (e.g. a licensed Topaz tpai.exe). Placeholders:
# {input} source file, {outdir} folder to write the result into, {scale}.
# UPSCALE_COMMAND="C:\path\to\tool.exe" "{input}" --scale {scale} --output "{outdir}"
# UPSCALE_ENGINE_LABEL=Topaz
